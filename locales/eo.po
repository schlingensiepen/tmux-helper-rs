msgstr "Rekonekti"

msgid "Set up host"
msgstr "Agordi gastiganton"

msgid "Delete"
msgstr "Forigi"

msgid "Open all detected sessions"
msgstr "Malfermi ĉiujn trovitajn seancojn"

msgid "Selection summary:"
msgstr "Resumo de elekto:"

msgid "(no selection)"
msgstr "(neniu elekto)"

msgid "Total: {total} session(s) on {hosts} host(s)"
msgstr "Entute: {total} seanco(j) sur {hosts} gastiganto(j)"

