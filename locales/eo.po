msgstr "Unu WT – Malfermi elekton"

msgid "Per host – Open selection"
msgstr "Po gastiganto – Malfermi elekton"

msgid "Delete host '{name}'?"
msgstr "Ĉu forigi gastiganton '{name}'?"

msgid "Yes"
msgstr "Jes"

msgid "No"
msgstr "Ne"

msgid "OK"
msgstr "Bone"

msgid "Error on {name}"
msgstr "Eraro ĉe {name}"

msgid "Waiting for pending connections..."
msgstr "Atendante pendantajn konektojn..."

msgid "Quit"
msgstr "Forlasi"

msgid "Delete host"
msgstr "Forigi gastiganton"

msgid "New host"
msgstr "Nova gastiganto"

msgid "Open"
msgstr "Malfermi"

msgid "Open all"
msgstr "Malfermi ĉiujn"

msgid "Language"
msgstr "Lingvo"

msgid "Select language:"
msgstr "Elekti lingvon:"

msgid "Cancel"
msgstr "Nuligi"

msgid "Language changed to {name}. Restart now?"
msgstr "Lingvo ŝanĝita al {name}. Ĉu rekomenci nun?"

msgid "SSH connection timed out"
msgstr "SSH-konekto eltempiĝis"

msgid "ssh executable not found"
msgstr "ssh-programo ne trovita"

msgid "SSH error: {error}"
msgstr "SSH-eraro: {error}"

msgid "SSH connection failed"
msgstr "SSH-konekto malsukcesis"

msgid "Setup: {host}"
msgstr "Agordo: {host}"

msgid "No SSH key found in %USERPROFILE%\\.ssh\\."
msgstr "Neniu SSH-ŝlosilo trovita en %USERPROFILE%\\.ssh\\."

msgid "Create one first with: ssh-keygen -t ed25519"
msgstr "Kreu unu unue per: ssh-keygen -t ed25519"

msgid "Press Enter to close"
msgstr "Premu Enigklavon por fermi"

msgid "Deploying {key} to {host}..."
msgstr "Sendante {key} al {host}..."

