# ============================================================
# Set up host (interactive WT for SSH key deployment)
# ============================================================

#: src/open_tmux_tabs/wt_launcher.py
msgid "Setup: {host}"
msgstr "Einrichtung: {host}"

#: src/open_tmux_tabs/wt_launcher.py
msgid "No SSH key found in %USERPROFILE%\\.ssh\\."
msgstr "Kein SSH-Schluessel gefunden in %USERPROFILE%\\.ssh\\."

#: src/open_tmux_tabs/wt_launcher.py
msgid "Create one first with: ssh-keygen -t ed25519"
msgstr "Erzeuge zuerst einen mit: ssh-keygen -t ed25519"

#: src/open_tmux_tabs/wt_launcher.py
msgid "Press Enter to close"
msgstr "Drücke Enter zum Beenden"

#: src/open_tmux_tabs/wt_launcher.py
msgid "Deploying {key} to {host}..."
msgstr "Deploye {key} auf {host}..."

#: src/open_tmux_tabs/wt_launcher.py
msgid "Key deployed."
msgstr "Schlüssel deployed."

