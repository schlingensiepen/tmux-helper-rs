msgstr "Host einrichten"

#: src/open_tmux_tabs/widgets/host_error.py
#: src/open_tmux_tabs/widgets/host_detail.py
msgid "Delete"
msgstr "Löschen"

# ============================================================
# Open view
# ============================================================

#: src/open_tmux_tabs/widgets/open_view.py
msgid "Open all detected sessions"
msgstr "Alle erkannten Sessions"

#: src/open_tmux_tabs/widgets/open_view.py
