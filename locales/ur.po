# Urdu translation for Open-TmuxTabs
#
# Note: Urdu is a right-to-left (RTL) script. Textual should
# render the glyphs correctly, though text direction in a TUI
# is limited. Technical terms (SSH, tmux, WT, host, session)
# are kept as loanwords.
#
msgid ""
msgstr ""
"Project-Id-Version: open-tmux-tabs 2.0.0\n"
"Language: ur\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "+ New host"
msgstr "+ نیا ہوسٹ"

msgid ">> Open"
msgstr ">> کھولیں"

msgid "SSH target (user@host or alias):"
msgstr "SSH ہدف (user@host یا عرفی نام):"

msgid "root@server or ssh-alias"
msgstr "root@server یا ssh-alias"

msgid "Add host"
msgstr "ہوسٹ شامل کریں"

msgid "Running sessions:"
msgstr "چل رہے سیشنز:"

msgid "Toggle: [t]   All: [a]   Invert: [i]"
msgstr "ٹوگل: [t]   سب: [a]   الٹ: [i]"

msgid "New sessions (one name per line):"
msgstr "نئے سیشنز (فی سطر ایک نام):"

msgid "Reload"
msgstr "دوبارہ لوڈ کریں"

msgid "Toggle"
msgstr "ٹوگل"

msgid "Toggle All"
msgstr "سب کو ٹوگل کریں"

msgid "Invert"
msgstr "الٹ کریں"

msgid "Jump start"
msgstr "فوری آغاز"

msgid "Invalid name: '{name}'"
msgstr "غلط نام: '{name}'"

msgid "A session named '{name}' already exists."
msgstr "'{name}' نامی سیشن پہلے سے موجود ہے۔"

msgid "Status: connection failed"
msgstr "حیثیت: کنکشن ناکام"

msgid "Reconnect"
msgstr "دوبارہ جڑیں"

msgid "Set up host"
msgstr "ہوسٹ ترتیب دیں"

msgid "Delete"
msgstr "حذف کریں"

msgid "Open all detected sessions"
msgstr "تمام پائے گئے سیشنز کھولیں"

msgid "Selection summary:"
msgstr "انتخاب کا خلاصہ:"

msgid "(no selection)"
msgstr "(کوئی انتخاب نہیں)"

msgid "Total: {total} session(s) on {hosts} host(s)"
msgstr "کل: {hosts} ہوسٹ پر {total} سیشن"

msgid "(existing)"
msgstr "(موجودہ)"

msgid "(new)"
msgstr "(نیا)"

msgid "One WT – Open selection"
msgstr "ایک WT – انتخاب کھولیں"

msgid "Per host – Open selection"
msgstr "فی ہوسٹ – انتخاب کھولیں"

msgid "Delete host '{name}'?"
msgstr "ہوسٹ '{name}' حذف کریں؟"

msgid "Yes"
msgstr "ہاں"

msgid "No"
msgstr "نہیں"

msgid "OK"
msgstr "ٹھیک ہے"

msgid "Error on {name}"
msgstr "{name} پر خرابی"

msgid "Waiting for pending connections..."
msgstr "زیر التواء کنکشنز کا انتظار..."

msgid "Quit"
msgstr "باہر نکلیں"

msgid "Delete host"
msgstr "ہوسٹ حذف کریں"

msgid "New host"
msgstr "نیا ہوسٹ"

msgid "Open"
msgstr "کھولیں"

msgid "Open all"
msgstr "سب کھولیں"

msgid "Language"
msgstr "زبان"

msgid "Select language:"
msgstr "زبان منتخب کریں:"

msgid "Cancel"
msgstr "منسوخ"

msgid "Language changed to {name}. Restart now?"
msgstr "زبان {name} میں تبدیل ہوگئی۔ ابھی دوبارہ شروع کریں؟"

msgid "SSH connection timed out"
msgstr "SSH کنکشن کا وقت ختم"

msgid "ssh executable not found"
msgstr "ssh فائل نہیں ملی"

msgid "SSH error: {error}"
msgstr "SSH خرابی: {error}"

msgid "SSH connection failed"
msgstr "SSH کنکشن ناکام"

msgid "Setup: {host}"
msgstr "ترتیب: {host}"

msgid "No SSH key found in %USERPROFILE%\\.ssh\\."
msgstr "%USERPROFILE%\\.ssh\\ میں کوئی SSH کلید نہیں ملی۔"

msgid "Create one first with: ssh-keygen -t ed25519"
msgstr "پہلے یہ چلائیں: ssh-keygen -t ed25519"

msgid "Press Enter to close"
msgstr "بند کرنے کے لیے Enter دبائیں"

msgid "Deploying {key} to {host}..."
msgstr "{key} کو {host} پر بھیجا جا رہا ہے..."

msgid "Key deployed."
msgstr "کلید بھیج دی گئی۔"

# ============================================================
# Direct Session / Show All (new features)
# ============================================================

msgid "Direct session"
msgstr "براہ راست سیشن"

msgid "Show all"
msgstr "مکمل جائزہ"

msgid "Host"
msgstr "ہوسٹ"

msgid "Session"
msgstr "سیشن"

msgid "Waiting for connections..."
msgstr "کنکشنز کا انتظار..."

msgid "One WT – Execute"
msgstr "ایک WT – عمل کریں"

msgid "Per host – Execute"
msgstr "فی ہوسٹ – عمل کریں"

msgid "Target hosts:"
msgstr "ہدف ہوسٹ:"

msgid "Session names (one per line):"
msgstr "سیشن نام (فی سطر ایک):"

msgid "Execute"
msgstr "عمل کریں"

# ============================================================
# Native Windows GUI (tmux-helper-rs): settings, tray, help overlay
# ============================================================

msgid "About"
msgstr "تعارف"

msgid "Adds the typed SSH target to the list and connects to it in the background."
msgstr "لکھا گیا SSH ہدف فہرست میں شامل کرتا ہے اور پس منظر میں اس سے جڑتا ہے۔"

msgid "Automatic (system language)"
msgstr "خودکار (سسٹم کی زبان)"

msgid "Background color:"
msgstr "پس منظر کا رنگ:"

msgid "Change"
msgstr "تبدیل کریں"

msgid "Connecting…"
msgstr "جڑ رہا ہے…"

msgid "Creates the missing sessions on the selected hosts and opens all of them in one Windows Terminal window. Selection and names stay, so you can run it again."
msgstr "منتخب ہوسٹس پر غائب سیشنز بناتا ہے اور سب کو ایک Windows Terminal ونڈو میں کھولتا ہے۔ انتخاب اور نام برقرار رہتے ہیں، اس لیے آپ دوبارہ چلا سکتے ہیں۔"

msgid "Creates the sessions typed in the field below on this host and opens them at once in one Windows Terminal window. Existing sessions with the same name are attached."
msgstr "نیچے والے خانے میں لکھے گئے سیشنز اس ہوسٹ پر بناتا ہے اور انہیں فوراً ایک Windows Terminal ونڈو میں کھولتا ہے۔ اسی نام کے موجودہ سیشنز سے جوڑ دیا جاتا ہے۔"

msgid "Ctrl"
msgstr "Ctrl"

msgid "Del"
msgstr "Del"

msgid "Direct start"
msgstr "براہ راست شروع کریں"

msgid "Enter"
msgstr "Enter"

msgid "Error"
msgstr "خرابی"

msgid "Fetches the session list from the host again."
msgstr "ہوسٹ سے سیشنز کی فہرست دوبارہ حاصل کرتا ہے۔"

msgid "Filter"
msgstr "فلٹر"

msgid "Filter…  (Ctrl+F)"
msgstr "فلٹر…  (Ctrl+F)"

msgid "Help"
msgstr "مدد"

msgid "Hide host '{name}'? It stays in your SSH config file; add it again with \"New host\"."
msgstr "ہوسٹ '{name}' چھپائیں؟ یہ آپ کی SSH کنفیگ میں رہتا ہے؛ \"نیا ہوسٹ\" سے دوبارہ شامل کریں۔"

msgid "Hotkey"
msgstr "ہاٹ کی"

msgid "Inverts the selection of the visible entries."
msgstr "نظر آنے والے اندراجات کا انتخاب الٹ دیتا ہے۔"

msgid "Jumps to Direct session: type session names once and start them on several hosts at the same time."
msgstr "براہ راست سیشن پر جاتا ہے: سیشن کے نام ایک بار لکھیں اور کئی ہوسٹس پر ایک ساتھ شروع کریں۔"

msgid "Jumps to Show all: one sortable table with the sessions of all reachable hosts."
msgstr "مکمل جائزہ پر جاتا ہے: تمام قابل رسائی ہوسٹس کے سیشنز کی ایک ترتیب دینے کے قابل جدول۔"

msgid "Jumps to \"New host\" and puts the cursor in the input field. Enter an SSH target such as user@server or an alias from your SSH config."
msgstr "\"نیا ہوسٹ\" پر جاتا ہے اور کرسر کو اندراج کے خانے میں رکھتا ہے۔ SSH ہدف لکھیں، جیسے user@server یا آپ کی SSH کنفیگ کا کوئی عرف۔"

msgid "Jumps to the Open view: summary of your selection and the quick start button."
msgstr "کھولیں والے منظر پر جاتا ہے: آپ کے انتخاب کا خلاصہ اور فوری آغاز کا بٹن۔"

msgid "Key:"
msgstr "کلید:"

msgid "Language:"
msgstr "زبان:"

msgid "Like Execute, but with one Windows Terminal window per host."
msgstr "عمل کریں جیسا، لیکن ہر ہوسٹ کے لیے ایک Windows Terminal ونڈو کے ساتھ۔"

msgid "Like One WT, but with one Windows Terminal window per host."
msgstr "ایک WT جیسا، لیکن ہر ہوسٹ کے لیے ایک Windows Terminal ونڈو کے ساتھ۔"

msgid "Moves the cursor into the search field above the current list. The list shows only entries that contain the text (upper and lower case do not matter). Esc or Arrow down returns to the list."
msgstr "کرسر کو موجودہ فہرست کے اوپر تلاش کے خانے میں رکھتا ہے۔ فہرست صرف وہ اندراجات دکھاتی ہے جن میں یہ متن ہو (چھوٹے بڑے حروف سے فرق نہیں پڑتا)۔ Esc یا نیچے کا تیر فہرست میں واپس لاتا ہے۔"

msgid "One WT"
msgstr "ایک WT"

msgid "Opens all running sessions on all reachable hosts right away, one Windows Terminal window per host. Waits for hosts that are still connecting."
msgstr "تمام قابل رسائی ہوسٹس پر چل رہے تمام سیشنز فوراً کھولتا ہے، ہر ہوسٹ کے لیے ایک Windows Terminal ونڈو۔ ابھی جڑ رہے ہوسٹس کا انتظار کرتا ہے۔"

msgid "Opens all selected sessions in a single Windows Terminal window. The selection stays."
msgstr "تمام منتخب سیشنز ایک ہی Windows Terminal ونڈو میں کھولتا ہے۔ انتخاب برقرار رہتا ہے۔"

msgid "Opens all selected sessions, and creates the new ones, in a single Windows Terminal window. Afterwards the selection is cleared."
msgstr "تمام منتخب سیشنز ایک ہی Windows Terminal ونڈو میں کھولتا ہے اور نئے بناتا ہے۔ اس کے بعد انتخاب صاف ہو جاتا ہے۔"

msgid "Opens an interactive Windows Terminal window that copies your public SSH key to the host. You type the password once; afterwards the host connects without a password."
msgstr "ایک انٹرایکٹو Windows Terminal ونڈو کھولتا ہے جو آپ کی عوامی SSH کلید ہوسٹ پر کاپی کرتی ہے۔ آپ پاس ورڈ ایک بار لکھتے ہیں؛ اس کے بعد ہوسٹ بغیر پاس ورڈ کے جڑتا ہے۔"

msgid "Opens the highlighted session immediately in a Windows Terminal tab. The selection stays as it is."
msgstr "نمایاں سیشن کو فوراً ایک Windows Terminal ٹیب میں کھولتا ہے۔ انتخاب تبدیل نہیں ہوتا۔"

msgid "Opens the selected sessions with one Windows Terminal window per host. The selection stays."
msgstr "منتخب سیشنز کو ہر ہوسٹ کے لیے ایک Windows Terminal ونڈو کے ساتھ کھولتا ہے۔ انتخاب برقرار رہتا ہے۔"

msgid "Opens the settings: language, hotkey, background color and start with Windows."
msgstr "ترتیبات کھولتا ہے: زبان، ہاٹ کی، پس منظر کا رنگ اور Windows کے ساتھ شروع کریں۔"

msgid "Per host"
msgstr "ہر ہوسٹ"

msgid "Please select a key."
msgstr "براہ کرم ایک کلید منتخب کریں۔"

msgid "Please select at least one modifier (Ctrl, Alt, Shift or Win)."
msgstr "براہ کرم کم از کم ایک موڈیفائر منتخب کریں (Ctrl، Alt، Shift یا Win)۔"

msgid "Press {hotkey} to show or hide the window."
msgstr "{hotkey} ونڈو دکھاتا یا چھپاتا ہے۔"

msgid "Quits Open-TmuxTabs. The sessions on the hosts keep running. Closing the window or pressing Esc only hides it in the notification area."
msgstr "Open-TmuxTabs بند کرتا ہے۔ ہوسٹس پر سیشنز چلتے رہتے ہیں۔ ونڈو بند کرنا یا Esc دبانا اسے صرف نوٹیفکیشن ایریا میں چھپاتا ہے۔"

msgid "Reads your SSH config file again and reconnects to all hosts."
msgstr "آپ کی SSH کنفیگ فائل دوبارہ پڑھتا ہے اور تمام ہوسٹس سے دوبارہ جڑتا ہے۔"

msgid "Reload hosts"
msgstr "ہوسٹس دوبارہ لوڈ کریں"

msgid "Removes the selected host after a confirmation. A host from your SSH config is only hidden in the app; the config file is not changed."
msgstr "تصدیق کے بعد منتخب ہوسٹ ہٹاتا ہے۔ SSH کنفیگ کا ہوسٹ ایپ میں صرف چھپایا جاتا ہے؛ کنفیگ فائل تبدیل نہیں ہوتی۔"

msgid "Selects all visible entries, or deselects them if all are selected already. Entries hidden by the filter stay as they are."
msgstr "تمام نظر آنے والے اندراجات منتخب کرتا ہے، یا اگر سب پہلے سے منتخب ہوں تو غیر منتخب کرتا ہے۔ فلٹر سے چھپے اندراجات ویسے ہی رہتے ہیں۔"

msgid "Selects or deselects the highlighted entry."
msgstr "نمایاں اندراج کو منتخب یا غیر منتخب کرتا ہے۔"

msgid "Settings"
msgstr "ترتیبات"

msgid "Settings file"
msgstr "ترتیبات کی فائل"

msgid "Shift"
msgstr "Shift"

msgid "Shows the explanations of all shortcuts of the current view."
msgstr "موجودہ منظر کے تمام شارٹ کٹس کی وضاحتیں دکھاتا ہے۔"

msgid "Sort by host"
msgstr "ہوسٹ کے لحاظ سے ترتیب دیں"

msgid "Sort by session"
msgstr "سیشن کے لحاظ سے ترتیب دیں"

msgid "Sorts the table by host. Press again to reverse the order."
msgstr "جدول کو ہوسٹ کے لحاظ سے ترتیب دیتا ہے۔ دوبارہ دبانے سے ترتیب الٹ جاتی ہے۔"

msgid "Sorts the table by session name. Press again to reverse the order."
msgstr "جدول کو سیشن کے نام کے لحاظ سے ترتیب دیتا ہے۔ دوبارہ دبانے سے ترتیب الٹ جاتی ہے۔"

msgid "Space"
msgstr "Space"

msgid "Start with Windows"
msgstr "Windows کے ساتھ شروع کریں"

msgid "The hotkey {hotkey} is already in use.\n\nPlease choose a different one in the settings."
msgstr "ہاٹ کی {hotkey} پہلے سے استعمال میں ہے۔\n\nبراہ کرم ترتیبات میں کوئی اور منتخب کریں۔"

msgid "The hotkey {hotkey} is already used by Windows or another program.\n\nPlease choose a different one."
msgstr "ہاٹ کی {hotkey} پہلے سے Windows یا کوئی اور پروگرام استعمال کر رہا ہے۔\n\nبراہ کرم کوئی اور منتخب کریں۔"

msgid "The settings could not be saved."
msgstr "ترتیبات محفوظ نہیں ہو سکیں۔"

msgid "Tries to connect to the host again."
msgstr "ہوسٹ سے دوبارہ جڑنے کی کوشش کرتا ہے۔"

msgid "Windows Terminal (wt.exe) could not be started."
msgstr "Windows Terminal (wt.exe) شروع نہیں ہو سکا۔"

msgid "hotkey not active"
msgstr "ہاٹ کی فعال نہیں"

msgid "tmux sessions on remote Linux hosts as Windows Terminal tabs."
msgstr "دور دراز Linux ہوسٹس پر tmux سیشنز، Windows Terminal ٹیبز کے طور پر۔"

msgid "{app} is running"
msgstr "{app} چل رہا ہے"

# Known hosts (DEC-077)

msgid "Known hosts"
msgstr "معلوم ہوسٹس"

msgid "The list below offers hosts from your known_hosts file that are not in the list yet, and all hidden hosts. Enter or double-click copies one into the input field; change the user if needed and press Enter to add it."
msgstr "نیچے کی فہرست آپ کی known_hosts فائل سے وہ ہوسٹس پیش کرتی ہے جو ابھی فہرست میں نہیں ہیں، اور تمام چھپے ہوئے ہوسٹس۔ Enter یا ڈبل کلک ایک کو اندراج کے خانے میں نقل کرتا ہے؛ ضرورت ہو تو صارف بدلیں اور شامل کرنے کے لیے Enter دبائیں۔"

msgid "Default user for known hosts:"
msgstr "معلوم ہوسٹس کے لیے طے شدہ صارف:"

msgid "empty = Windows user"
msgstr "خالی = Windows صارف"

msgid "Hide host '{name}'? It stays in your known_hosts file; you can get it back under \"New host\"."
msgstr "ہوسٹ '{name}' چھپائیں؟ یہ آپ کی known_hosts فائل میں رہتا ہے؛ آپ اسے \"نیا ہوسٹ\" میں واپس لا سکتے ہیں۔"

msgid "Known and hidden hosts:"
msgstr "معلوم اور چھپے ہوئے ہوسٹس:"

msgid "(hidden)"
msgstr "(چھپا ہوا)"
